{
  "name": "ai-novelist-studio",
  "productName": "AI Novelist Studio",
  "version": "1.1.3",
  "description": "AIのべりすと API を使った小説執筆・チャットツール",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "icon": "node scripts/make-icon.js",
    "setup:readability": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-readability.ps1",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.ainoveliststudio.app",
    "productName": "AI Novelist Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "mecab-dist/**",
          "unidic-mecab/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jreadability": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  }
}
